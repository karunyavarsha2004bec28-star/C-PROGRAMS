#include <stdio.h>
#include <stdlib.h>
#include <string.h>


void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}


int compare(const void *a, const void *b) {
    const int *c1 = *(const int **)a;
    const int *c2 = *(const int **)b;
    if (c1[0] != c2[0]) return c1[0] - c2[0];
    if (c1[1] != c2[1]) return c1[1] - c2[1];
    return c1[2] - c2[2];
}


int canPlace(int *c_top, int *c_bottom) {
    return c_top[0] <= c_bottom[0] && 
           c_top[1] <= c_bottom[1] && 
           c_top[2] <= c_bottom[2];
}

int maxHeight(int** cuboids, int cuboidsSize, int* cuboidsColSize) {
    
    for (int i = 0; i < cuboidsSize; i++) {
        if (cuboids[i][0] > cuboids[i][1]) swap(&cuboids[i][0], &cuboids[i][1]);
        if (cuboids[i][1] > cuboids[i][2]) swap(&cuboids[i][1], &cuboids[i][2]);
        if (cuboids[i][0] > cuboids[i][1]) swap(&cuboids[i][0], &cuboids[i][1]);
    }

    
    qsort(cuboids, cuboidsSize, sizeof(int *), compare);

    
    int *dp = (int *)malloc(cuboidsSize * sizeof(int));
    int maxSum = 0;

    for (int i = 0; i < cuboidsSize; i++) {
        dp[i] = cuboids[i][2]; 
        for (int j = 0; j < i; j++) {
            if (canPlace(cuboids[j], cuboids[i])) {
                if (dp[j] + cuboids[i][2] > dp[i]) {
                    dp[i] = dp[j] + cuboids[i][2];
                }
            }
        }
        if (dp[i] > maxSum) {
            maxSum = dp[i];
        }
    }

    free(dp);
    return maxSum;
}

