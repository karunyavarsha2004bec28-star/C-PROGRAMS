#include <stdlib.h>
#include <string.h>

char** rotateTheBox(char** boxGrid, int boxGridSize, int* boxGridColSize, int* returnSize, int** returnColumnSizes) {
    int m = boxGridSize;
    int n = boxGridColSize[0];
    
    
    for (int i = 0; i < m; i++) {
        int empty_pos = n - 1; 
        for (int j = n - 1; j >= 0; j--) {
            if (boxGrid[i][j] == '*') {
                empty_pos = j - 1; 
            } else if (boxGrid[i][j] == '#') {
                if (j < empty_pos) {
                    boxGrid[i][empty_pos] = '#';
                    boxGrid[i][j] = '.';
                }
                empty_pos--; 
            }
        }
    }
    
    
    *returnSize = n;
    *returnColumnSizes = (int*)malloc(n * sizeof(int));
    char** rotatedBox = (char**)malloc(n * sizeof(char*));
    
    for (int i = 0; i < n; i++) {
        (*returnColumnSizes)[i] = m;
        rotatedBox[i] = (char*)malloc(m * sizeof(char));
    }
    
    
    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            rotatedBox[j][m - 1 - i] = boxGrid[i][j];
        }
    }
    
    return rotatedBox;
}
