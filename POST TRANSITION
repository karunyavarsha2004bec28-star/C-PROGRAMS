#define MAX_STRING_LENGTH 6

struct package {
    char* id;
    int weight;
};
typedef struct package package;


struct post_office {
    int min_weight;
    int max_weight;
    struct package* packages;
    int packages_count;
};
typedef struct post_office post_office;

struct town {
    char* name;
    struct post_office* offices;
    int offices_count;
};
typedef struct town town;


