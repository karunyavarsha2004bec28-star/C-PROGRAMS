#include <stdio.h>
#include <stdlib.h>


int* rotateLeft(int d, int* arr, int n) {
   
    int* rotated_arr = (int*)malloc(n * sizeof(int));
    
    
    d = d % n;
    
   
    for (int i = 0; i < n; i++) {
        int new_position = (i - d + n) % n;
        rotated_arr[new_position] = arr[i];
    }
    
    return rotated_arr;
}

int main() {
    int n, d;
    if (scanf("%d %d", &n, &d) == EOF) return 0;
    
    int* arr = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) == EOF) return 0;
    }
    
    int* result = rotateLeft(d, arr, n);
    
    
    for (int i = 0; i < n; i++) {
        printf("%d", result[i]);
        if (i < n - 1) {
            printf(" ");
        }
    }
    printf("\n");
    
 
    free(arr);
    free(result);
    
    return 0;
}
