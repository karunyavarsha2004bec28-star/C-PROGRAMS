#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
int marks_summation(int* marks, int number_of_students, char gender) {
    int sum = 0;
    
    // Set starting index: index 0 for boys ('b'), index 1 for girls ('g')
    int start_index = (gender == 'b') ? 0 : 1;
    
    // Increment by 2 to grab alternating elements safely
    for (int i = start_index; i < number_of_students; i += 2) {
        sum += marks[i];
    }
    
    return sum;
}

